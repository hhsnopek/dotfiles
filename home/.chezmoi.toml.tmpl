{{- $tailscaleSSH := false -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $tailscaleSSH = promptBoolOnce . "tailscaleSSH" "Install the Tailscale CLI build so this Mac accepts Tailscale SSH (no GUI app)" false -}}
{{- end -}}
{{- $signCommits := promptBoolOnce . "signCommits" "Sign git commits with GPG key E2BCA15796515B33 (imported from 1Password)" true -}}
{{- $private := promptBoolOnce . "private" "Run the Private setup note from 1Password" false -}}
{{- $work := promptBoolOnce . "work" "Run the private Work setup note from 1Password" false -}}
{{- $sshKeyItem := promptStringOnce . "sshKeyItem" "1Password item in the dotfiles vault holding this machine's SSH key (blank for none)" "" -}}
sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
tailscaleSSH = {{ $tailscaleSSH }}
signCommits = {{ $signCommits }}
private = {{ $private }}
work = {{ $work }}
sshKeyItem = {{ $sshKeyItem | quote }}
opAccount = "my.1password.com"
