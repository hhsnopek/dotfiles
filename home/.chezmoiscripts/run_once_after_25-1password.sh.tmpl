{{- /* Renders empty until the 1Password CLI exists, so a fresh machine picks it up on the apply after 10-packages installs it. */ -}}
{{ if lookPath "op" -}}
#!/bin/bash
set -euo pipefail
op() { command op --account {{ .opAccount | quote }} "$@"; }
{{- if eq .chezmoi.os "darwin" }}

# f.lux times sunset from the home location, which stays out of this repo.
for field in location locationTextField locationType; do
	defaults write org.herf.Flux "$field" -string "$(op read "op://dotfiles/f.lux location/$field")"
done
{{- end }}
{{- if .signCommits }}

if ! gpg --list-secret-keys E2BCA15796515B33 >/dev/null 2>&1; then
	op document get "GPG signing key E2BCA15796515B33" --vault dotfiles | gpg --batch --import
	echo "684AC666C50649B61B5ED10EE2BCA15796515B33:6:" | gpg --import-ownertrust
fi
{{- end }}
{{- if .work }}

for doc in .pgpass .pg_service.conf; do
	[ -f "$HOME/$doc" ] && continue
	op document get "$doc" --vault dotfiles --out-file "$HOME/$doc"
	chmod 600 "$HOME/$doc"
done
{{- end }}
{{ end -}}
