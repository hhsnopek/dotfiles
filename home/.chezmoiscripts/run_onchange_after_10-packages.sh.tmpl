{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Reruns whenever the rendered Brewfile changes: {{ includeTemplate "private_dot_config/homebrew/Brewfile.tmpl" . | sha256sum }}
set -euo pipefail
eval "$(/opt/homebrew/bin/brew shellenv)"
brew bundle --no-upgrade --file="$HOME/.config/homebrew/Brewfile"
{{ else if eq .chezmoi.os "linux" -}}
#!/bin/bash
# neovim {{ .neovim }}
set -euo pipefail
can_sudo() { [ -t 0 ] || sudo -n true 2>/dev/null; }

missing=()
for pkg in {{ concat .apt .linux.apt | join " " }}; do
	dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed' || missing+=("$pkg")
done
debs=()
{{- range .linux.debs }}
have=$(dpkg-query -W -f='${Version}' {{ .name }} 2>/dev/null || true)
if [ -z "$have" ]{{ if hasKey . "version" }} || [ "$have" != {{ .version | quote }} ]{{ end }}; then
	debs+=({{ .url | quote }})
fi
{{- end }}
if ((${#missing[@]} + ${#debs[@]})); then
	if can_sudo; then
		dir=$(mktemp -d)
		trap 'rm -rf "$dir"' EXIT
		files=()
		for url in "${debs[@]}"; do
			files+=("$dir/${url##*/}")
			curl -fsSL -o "${files[-1]}" "$url"
		done
		sudo apt-get install -y "${missing[@]}" "${files[@]}"
	else
		echo "chezmoi: run chezmoi apply in a terminal, to install ${missing[*]} ${debs[*]##*/}" >&2
	fi
fi

if getent group docker >/dev/null && ! id -nG "$USER" | grep -qw docker; then
	if can_sudo; then
		sudo usermod -aG docker "$USER"
		echo "chezmoi: log out and back in to use docker without sudo" >&2
	else
		echo "chezmoi: needs 'sudo usermod -aG docker $USER'" >&2
	fi
fi

# Ubuntu 24.04 ships Neovim 0.9, too old for the vim.pack config, so the
# upstream release goes under ~/.local and needs no root.
nvim_dir="$HOME/.local/opt/nvim-{{ .neovim }}"
if [ ! -x "$nvim_dir/bin/nvim" ]; then
	mkdir -p "$nvim_dir"
	curl -fsSL "https://github.com/neovim/neovim/releases/download/v{{ .neovim }}/nvim-linux-x86_64.tar.gz" |
		tar -xz -C "$nvim_dir" --strip-components=1
fi
mkdir -p "$HOME/.local/bin"
ln -sfn "$nvim_dir/bin/nvim" "$HOME/.local/bin/nvim"

uv=$(command -v uv || echo "$HOME/.local/bin/uv")
if [ -x "$uv" ] && [ ! -x "$HOME/.local/bin/nvr" ]; then
	"$uv" tool install neovim-remote
fi
{{ end -}}
