{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# node {{ .node }}; npm: {{ .npm | join " " }}
set -euo pipefail
eval "$(/opt/homebrew/bin/brew shellenv)"

export N_PREFIX="$HOME/n"
export PATH="$N_PREFIX/bin:$PATH"
n {{ .node }}
npm install --global {{ .npm | join " " }}

if [ ! -x "$HOME/.cargo/bin/rustup" ]; then
	curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs | sh -s -- -y --no-modify-path
fi
"$HOME/.cargo/bin/rustup" target add x86_64-unknown-linux-gnu
if [ ! -x "$HOME/.cargo/bin/cross" ]; then
	# The gitconfig sends GitHub clones over SSH, which cargo's built-in git
	# cannot authenticate; the git CLI uses ~/.ssh like everything else.
	CARGO_NET_GIT_FETCH_WITH_CLI=true "$HOME/.cargo/bin/cargo" install cross --git https://github.com/cross-rs/cross
fi

if [ ! -x "$HOME/.local/bin/claude" ]; then
	curl -fsSL https://claude.ai/install.sh | bash
fi
{{ end -}}
