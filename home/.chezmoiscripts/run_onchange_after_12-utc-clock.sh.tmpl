{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Built from source because no notarized UTC menu bar clock exists, and
# Gatekeeper only checks downloaded apps.
set -euo pipefail
version={{ .utcClock | quote }}
have=$(defaults read "/Applications/UTC Clock.app/Contents/Info" CFBundleShortVersionString 2>/dev/null || true)
[ "$have" = "$version" ] && exit 0

dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
git -c advice.detachedHead=false clone --quiet --depth 1 --branch "v$version" https://github.com/hhsnopek/utc-clock.git "$dir"
make -C "$dir" install
{{ end -}}
