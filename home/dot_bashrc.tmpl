# shellcheck shell=bash

# PATH, deliberately above the interactive guard below.
#
# Everything past that guard is skipped for non-interactive shells, and Claude
# Code is launched by `bash -l -c claude`: a non-interactive login shell, which
# reads .bash_profile, which sources this file, and would then return one line
# from here having set no PATH at all. Anything that has to reach a tool call
# belongs above the guard.

{{ if eq .chezmoi.os "darwin" -}}
# Homebrew first, since everything below is expressed relative to its prefix.
if [ -z "${HOMEBREW_PREFIX:-}" ] && [ -x /opt/homebrew/bin/brew ]; then
	eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# prepend_path puts a directory at the front, moving it there when it is
# already somewhere else rather than leaving it where it sits.
#
# The move matters as much as the deduplication: a guard that only skips
# directories already present leaves them stranded wherever a later line
# pushed them, which is how the GNU coreutils ended up behind /usr/bin while
# looking correctly installed.
prepend_path() {
	[ -d "$1" ] || return 0
	local p=":${PATH}:"
	while [ "${p//:$1:/:}" != "$p" ]; do
		p="${p//:$1:/:}"
	done
	p="${p#:}"
	p="${p%:}"
	PATH="$1${p:+:$p}"
}

prepend_manpath() {
	[ -d "$1" ] || return 0
	local m=":${MANPATH:-}:"
	while [ "${m//:$1:/:}" != "$m" ]; do
		m="${m//:$1:/:}"
	done
	m="${m#:}"
	m="${m%:}"
	MANPATH="$1${m:+:$m}"
}

# GNU userland ahead of the BSD tools in /usr/bin, so sed, awk, find and date
# take the flags scripts are written against.
#
# Each directory is added only if it exists. `brew --prefix <formula>` answers
# with a path whether or not the formula is installed, so testing the prefix
# rather than the directory is what once filled PATH with entries resolving to
# nothing.
for _gnu in coreutils gnu-sed gawk findutils grep gnu-tar; do
	prepend_path "${HOMEBREW_PREFIX}/opt/${_gnu}/libexec/gnubin"
	prepend_manpath "${HOMEBREW_PREFIX}/opt/${_gnu}/libexec/gnuman"
done
unset _gnu

# Homebrew's own bin ahead of /usr/bin as well, which is what makes `bash`
# mean the 5.x installed here rather than the 3.2 Apple ships.
prepend_path "${HOMEBREW_PREFIX}/sbin"
prepend_path "${HOMEBREW_PREFIX}/bin"
export PATH MANPATH
{{- end }}

