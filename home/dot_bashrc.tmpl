function delete-branches() {
  git branch |
    grep --invert-match '\*' |
    cut -c 3- |
    fzf --multi --preview="git log {} --" |
    xargs -r git branch --delete --force
}

function branches() {
  while test $# -gt 0; do
    case "$1" in
      -h|--help)
        echo "$branches - git-branch selection w/fzf"
        echo " "
        echo "$branches [options]"
        echo " "
        echo "options:"
        echo "-h, --help                show brief help"
        echo "-u, --update              fetch remote branches"
        exit 0
        ;;
      -u|--update)
        shift
        git remote update
        shift
        ;;
      *)
        break
        ;;
    esac
  done

  git branch |
    grep --invert-match '\*' |
    cut -c 3- |
    fzf --multi --preview="git log {} --" |
    xargs -r git checkout
}

# kill files
fkill() {
  local pid
  if [ "$UID" != "0" ]; then
    pid=$(ps -f -u $UID | sed 1d | fzf -m | awk '{print $2}')
  else
    pid=$(ps -ef | sed 1d | fzf -m | awk '{print $2}')
  fi

  if [ "x$pid" != "x" ]; then
    echo $pid | xargs kill -${1:-9}
  fi
}

