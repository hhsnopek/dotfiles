fr() {
  local excludes=
  local fType=
  fType="${2}"
  if [[ -f '.gitignore' ]]; then
    for file in $(cat .gitignore); do
      if [[ -f "${file}" ]]; then
        excludes+=" ! -wholename '*${file}'"
      elif [[ -d "${file}" ]]; then
        excludes+=" ! -wholename './${file/\//}/*'"
      fi
    done
  fi
  if [[ "${fType}" == "" ]]; then

    fType="'*'"
  fi

  echo "find . -type f -name ${fType}${excludes} -exec sed -i '${1}' {} +"
  find . -type f -name ${fType}${excludes} -exec sed -i '${1}' {} +
}

