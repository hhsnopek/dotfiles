  local rc=$?
  local dir
  dir=$(cat "$tmpfile")
  rm -f "$tmpfile"
  if [[ -n "$dir" && -d "$dir" ]]; then
    cd "$dir"
  fi
  return $rc
}
{{- end }}

# Per-machine settings that stay out of this repo.
[ -f ~/.bashrc.local ] && . ~/.bashrc.local

