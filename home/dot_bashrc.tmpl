# which outranks the function; re-sourcing this file drops it.
unalias brewski 2>/dev/null
# --greedy also upgrades casks that update themselves or track :latest, which
# plain `brew upgrade` skips. Every step runs even when an earlier one fails,
# but brew catches ^C and exits 130, so any signal status stops the rest.
function brewski {
	local step status failed=()
	for step in update upgrade cleanup doctor; do
		if [[ $step == upgrade ]]; then
			brew upgrade --greedy --yes
		else
			brew "$step"
		fi
		status=$?
		((status > 128)) && return "$status"
		((status != 0)) && failed+=("$step")
	done
	((${#failed[@]} == 0)) && return
	echo "brewski: failed: ${failed[*]}" >&2
	return 1
}
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
JAVA_HOME="$(brew --prefix)/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home"
