function kport() {
  local port name pid tmp choice
  port="${@}"
  tmp=$(lsof -i :"$port" -sTCP:LISTEN | awk 'NR > 1')
  name=$(echo "$tmp" | awk 'NR > 1 {print $1} {print $1}')
  pid=$(echo "$tmp" | awk 'NR > 1 {print $1} {print $2}')

  if [[ "${pid}" == "" ]]; then
    echo "No process found."
    return 0
  fi

  echo "Found process, name=${name} port=${port} pid=${pid}"
  read -r -p "Kill process? (y/N)? " choice
  case "$choice" in
    y|Y ) if "$(kill -9 "$pid")"; then echo "Killed"; fi ;;
    * ) echo "No action taken";;
  esac
}

function retry() {
  local retries="$1" # First argument
  local command="$2" # Second argument

  # Run the command, and save the exit code
  $command
  local exit_code=$?

  # If the exit code is non-zero (i.e. command failed), and we have not
  # reached the maximum number of retries, run the command again
  if [[ $exit_code -ne 0 && $retries -gt 0 ]]; then
    retry $(($retries - 1)) "$command"
  else
    # Return the exit code from the command
    return $exit_code
  fi
}

