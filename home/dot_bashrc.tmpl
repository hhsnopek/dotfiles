# Interactive psql connect via fzf
# Usage: clerkdb [filter]
clerkdb() {
  local locals="dev
test
su
su/test"
  local remotes
  remotes=$(grep '^\[' ~/.pg_service.conf 2>/dev/null | tr -d '[]')

  local choice
  choice=$(printf '%s\n%s' "$locals" "$remotes" | fzf --prompt="clerkdb> " --query="${1:-}")
  [[ -z "$choice" ]] && return

  case "$choice" in
    dev)     docker exec -it clerk-db-dev psql --user=app_user clerk ;;
    test)    docker exec -it clerk-db-test psql --user=app_user clerk-test ;;
    su)      docker exec -it clerk-db-dev psql --user=postgres clerk ;;
    su/test) docker exec -it clerk-db-test psql --user=postgres clerk-test ;;
    *)       psql "service=$choice" ;;
  esac
}

