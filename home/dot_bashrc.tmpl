# The Mac's brewski for apt and snap. --with-new-pkgs takes upgrades that need
# new dependencies but, unlike full-upgrade, never removes a package. Every
# step runs even when an earlier one fails, but a signal status stops the rest.
function brewski {
	local step status failed=()
	for step in update upgrade cleanup snap doctor; do
		case $step in
		update) sudo apt-get update ;;
		upgrade) sudo apt-get upgrade --with-new-pkgs -y ;;
		cleanup) sudo apt-get autoremove --purge -y && sudo apt-get autoclean ;;
		snap) sudo snap refresh ;;
		doctor) sudo apt-get check && dpkg --audit ;;
		esac
		status=$?
		((status > 128)) && return "$status"
		((status != 0)) && failed+=("$step")
	done
	((${#failed[@]} == 0)) && return
	echo "brewski: failed: ${failed[*]}" >&2
	return 1
}
{{- end }}
